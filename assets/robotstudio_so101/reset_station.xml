<mujoco model="reset_station">
  <include file="so101.xml"/>

  <!-- 坐标约定：机械臂底座底面在原点，立着朝 +x 伸出；单位 m；box 的 size 是半长
       机械臂在缸内：底座坐在平台上，平台固定在后墙内侧
       鱼缸内部：x -0.06（后墙）..0.94（前墙），y -0.25..0.25，z -0.16（缸底顶面）..0.35（缸沿）；玻璃厚 0.005
         1 m × 0.5 m（10-20 定）：机械臂只能在离底座约 0.06–0.37 m 内竖直朝下夹桅杆（见 docs/reach_map.png），
         所以复位分两步：BODY2 自己游进可抓区 → 机械臂夹住、定位、调头
         缸壁高到 z = 0.35，把机械臂围在里面；以后环境里碰到缸壁要扣分
       水面：z = -0.04（底座下 4 cm）；水深 0.12 -->

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>

    <!-- 桌面：缸放在上面，只为了看着有参照 -->
    <geom name="table" type="plane" pos="0 0 -0.165" size="0 0 0.05" rgba="0.35 0.35 0.35 1"/>

    <!-- 鱼缸：5 块玻璃，直接挂在 worldbody 下 → 固定不动 -->
    <!-- 缸底：x -0.065..0.945，y -0.255..0.255，z -0.165..-0.16 -->
    <geom name="tank_bottom"     type="box" pos="0.44    0       -0.1625" size="0.505  0.255  0.0025" rgba="0.7 0.85 0.9 0.3"/>
    <!-- 后墙（机械臂这侧）：x -0.065..-0.06；前墙：x 0.94..0.945；两面都是 y -0.25..0.25，z -0.16..0.35 -->
    <geom name="tank_wall_back"  type="box" pos="-0.0625 0       0.095"   size="0.0025 0.25   0.255"  rgba="0.7 0.85 0.9 0.3"/>
    <geom name="tank_wall_front" type="box" pos="0.9425  0       0.095"   size="0.0025 0.25   0.255"  rgba="0.7 0.85 0.9 0.3"/>
    <!-- 两侧墙：x -0.065..0.945（盖住前后墙的厚度），y ±(0.25..0.255)，z -0.16..0.35 -->
    <geom name="tank_wall_yneg"  type="box" pos="0.44    -0.2525 0.095"   size="0.505  0.0025 0.255"  rgba="0.7 0.85 0.9 0.3"/>
    <geom name="tank_wall_ypos"  type="box" pos="0.44    0.2525  0.095"   size="0.505  0.0025 0.255"  rgba="0.7 0.85 0.9 0.3"/>

    <!-- 平台：x -0.06..0.07（后端贴住后墙内侧），y -0.07..0.07，z -0.01..0（顶面就是底座底面） -->
    <geom name="mount_plate" type="box" pos="0.005 0 -0.005" size="0.065 0.07 0.005" rgba="0.6 0.45 0.3 1"/>

    <!-- 隔板：横跨整个缸宽，两端贴住左右缸壁，把缸分成"机械臂区"（x < 0.08）和"船区"（x > 0.085）
         作用：船进不到平台和机械臂底座下面（船顶比平台底面高 3 mm、桅杆比底座高 5 cm，否则会撞上）
         范围：x 0.08..0.085，y -0.25..0.25，z -0.16（缸底）..0.01（比船顶 -0.007 高 1.7 cm，桅杆照样从上面伸过来夹）
         真机：一块 5 mm 亚克力板，两端粘或夹在缸壁上 -->
    <geom name="fence" type="box" pos="0.0825 0 -0.075" size="0.0025 0.25 0.085" rgba="0.9 0.9 0.9 0.5"/>

    <!-- BODY2 替身：船体盒子 + 中央竖直桅杆（给夹爪从上往下夹，转 wrist_roll 可让船原地调头）
         船体 0.262 × 0.116 × 0.05 m（旧托盘实测尺寸），0.5 kg；body 原点 = 船体中心，初始放在水面高度（水线约在半高）
         桅杆 3 cm（沿船长 x）× 1 cm（y）× 6 cm 高，立在船体顶面中央：中心 z = 0.025 + 0.03 = 0.055
         freejoint：6 自由度，可以漂；每回合的位置、朝向、初速度以后在 Python 的 reset() 里随机 -->
    <body name="body2" pos="0.25 0 -0.04">
      <freejoint name="body2_free"/>
      <geom name="body2_hull" type="box" pos="0 0 0"     size="0.131 0.058 0.025" mass="0.5"  rgba="0.9 0.6 0.2 1"/>
      <geom name="body2_mast" type="box" pos="0 0 0.055" size="0.015 0.005 0.03"  mass="0.01" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- 水：只是看的，不参与碰撞（contype/conaffinity = 0）；浮力和阻力以后在 Python 里算
         x -0.06..0.94，y -0.25..0.25，z -0.16..-0.04 -->
    <geom name="water" type="box" pos="0.44 0 -0.10" size="0.50 0.25 0.06" rgba="0.2 0.45 0.8 0.25" contype="0" conaffinity="0"/>
  </worldbody>

  <!-- 初始姿态 home：每回合从这个收拢姿态开始（前墙加长后全 0 姿态也不碰墙，但伸直的手臂不适合当起点）
       顺序：shoulder_pan shoulder_lift elbow_flex wrist_flex wrist_roll gripper（弧度）；夹爪尖端约在 (0.16, 0, 0.09)
       viewer 里：左侧 Simulation → Key 选 0 → Load key -->
  <keyframe>
    <key name="home" qpos="0 -1.2 0.8 1.6 0 0" ctrl="0 -1.2 0.8 1.6 0 0"/>
  </keyframe>
</mujoco>
